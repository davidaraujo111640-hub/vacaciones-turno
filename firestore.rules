rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esLara() {
      return request.auth != null && request.auth.uid == '2iFYWcnlWEQAWwqRqxWOoICzVtm1';
    }
    // Días pedidos: cualquiera puede ver, pedir, cambiar o retirar
    match /requests/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['person', 'date', 'type', 'at'])
        && request.resource.data.person is string && request.resource.data.person.size() < 30
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.type in ['V', 'AP', 'NAV', 'SS', 'OTRO'];
    }
    // Días confirmados: todos los ven, solo Lara confirma
    match /confirmed/{id} {
      allow read: if true;
      allow write: if esLara();
    }
    // Historial: se puede leer y añadir, pero no borrar ni modificar. Confirmar y denegar, solo Lara
    match /log/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['person', 'date', 'type', 'action', 'at'])
        && (request.resource.data.action in ['pide', 'cambia', 'retira']
            || (request.resource.data.action in ['confirma', 'deniega', 'deshace'] && esLara()));
    }
  }
}
