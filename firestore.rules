rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Responsables que pueden confirmar y denegar: Lara y Udyki
    function esResponsable() {
      return request.auth != null
        && request.auth.uid in ['2iFYWcnlWEQAWwqRqxWOoICzVtm1', 'nqUXnklNkIQseGfMZSoUAOS1hMy1'];
    }
    // Días pedidos: cualquiera puede ver, pedir, cambiar o retirar
    match /requests/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['person', 'date', 'type', 'at'])
        && request.resource.data.person is string && request.resource.data.person.size() < 30
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.type in ['V26', 'V27', 'AP26', 'AP27', 'NAV', 'SS', 'OTRO'];
    }
    // Días confirmados: todos los ven, solo los responsables confirman
    match /confirmed/{id} {
      allow read: if true;
      allow write: if esResponsable();
    }
    // Cursos y quién va a cada uno: todos los ven, solo los responsables los modifican
    match /courses/{id} {
      allow read: if true;
      allow write: if esResponsable();
    }
    match /assignments/{id} {
      allow read: if true;
      allow write: if esResponsable();
    }
    // Historial: se puede leer y añadir, pero no borrar ni modificar.
    // Confirmar, denegar y deshacer, solo los responsables, firmando con su propia cuenta
    match /log/{id} {
      allow read: if true;
      allow create: if (request.resource.data.keys().hasOnly(['person', 'date', 'type', 'action', 'at'])
            && request.resource.data.action in ['pide', 'cambia', 'retira'])
        || (request.resource.data.keys().hasOnly(['person', 'date', 'type', 'action', 'by', 'at'])
            && request.resource.data.action in ['confirma', 'deniega', 'deshace']
            && esResponsable() && request.resource.data.by == request.auth.uid);
    }
  }
}
